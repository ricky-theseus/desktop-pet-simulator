<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GodotDisabledSourceGenerators>ScriptPathAttribute</GodotDisabledSourceGenerators>
    <AssemblyName>Example.DeskLamp.Mod</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(DesktopPetSdkDirectory)' == ''">
    <ProjectReference Include="../../core/DesktopPet.Core/DesktopPet.Core.csproj" Private="false" />
    <ProjectReference Include="../../sdk/DesktopPet.Godot/DesktopPet.Godot.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(DesktopPetSdkDirectory)' != ''">
    <Reference Include="DesktopPet.Core" HintPath="$(DesktopPetSdkDirectory)/DesktopPet.Core.dll" Private="false" />
    <Reference Include="DesktopPet.Godot" HintPath="$(DesktopPetSdkDirectory)/DesktopPet.Godot.dll" Private="false" />
  </ItemGroup>
</Project>
