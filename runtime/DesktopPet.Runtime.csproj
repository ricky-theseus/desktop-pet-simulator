<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\core\DesktopPet.Core\DesktopPet.Core.csproj" />
    <ProjectReference Include="..\mods\official\mushroom\DesktopPet.OfficialMushroom.csproj" />
    <Compile Include="..\mods\official\mod-manager\*.cs" Link="OfficialMods\ModManager\%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="$(PrivateDistributionTargets)" Condition="'$(PrivateDistributionTargets)' != '' and Exists('$(PrivateDistributionTargets)')" />
  <Target Name="CheckPrivateDistributionTargets" BeforeTargets="BeforeBuild" Condition="'$(PrivateDistributionTargets)' != '' and !Exists('$(PrivateDistributionTargets)')">
    <Error Text="指定的本地发行构建文件不存在。" />
  </Target>
</Project>
